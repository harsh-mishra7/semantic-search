{
  // Point the Python extension -- and Pyrefly, which takes the interpreter
  // from it -- at this project's virtualenv. Left unset, the editor falls
  // back to the system python, which has none of these dependencies, and
  // every third-party import is squiggled as missing in a project that runs.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}
